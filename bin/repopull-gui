#!/usr/bin/env bash
# Launch the optional PySide6 interface from this checkout.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  script_path="$(readlink -f -- "$script_path")"
fi
project_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd)"

export REPOPULL_HOME="${REPOPULL_HOME:-$project_root}"
export PYTHONPATH="${project_root}/src${PYTHONPATH:+:${PYTHONPATH}}"

if python3 -c 'import PySide6' >/dev/null 2>&1; then
  exec python3 -m repopull.gui "$@"
fi

# No PySide6 on this interpreter: let uv provide it for this run only.
exec uv run --no-project --with 'PySide6-Essentials>=6.8,<7' -- \
  python -m repopull.gui "$@"
